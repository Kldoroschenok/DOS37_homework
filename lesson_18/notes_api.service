[Unit]
Description=Notes API with DB Replication
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/notes_api
Environment="PRIMARY_DSN=host=192.168.252.98 port=5432 dbname=notes user=app_user password=app_password"
Environment="REPLICA_DSN=host=192.168.252.90 port=5432 dbname=notes user=app_user password=app_password"
ExecStart=/opt/notes_api/venv/bin/python /opt/notes_api/notes_api.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
